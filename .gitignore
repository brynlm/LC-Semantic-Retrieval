# Secrets -- never commit
.env
static_site/.dev.vars

# Dev-only data (LLM-generated abstract text) for local debugging -- must
# never be deployed or committed; see export_static_data.py's docstring
static_site/data-dev-mechanisms.json

# Data caches -- large, regeneratable from the pipeline scripts, not source
*.pkl

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Node / Cloudflare tooling (used for local wrangler testing of the
# serverless function; not needed in the repo itself)
node_modules/
.wrangler/

# Local environment / editor / tool state -- not project source
.conda/
.claude/
.vscode/

# Personal ops/debug utility for querying visitor-count KV data directly --
# not part of the project's actual functionality, no need to publish it
check_visits.py

.dev.vars*
!.dev.vars.example
!.env.example
